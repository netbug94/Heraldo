# ========================================================
# Heraldo Environment Variables
# Copy this to .env and fill in your secrets
# ========================================================

# Secure API Key shared between Mensajero and Gestor
MENSAJERO_API_KEY=your_secure_random_hash_here

# Internal URL for Gestor to reach the Mensajero container
MENSAJERO_URL=http://mensajero:3000

# The WhatsApp Phone number to send tasks to (include country code)
MENSAJERO_PHONE=+1234567890

# Message template
MENSAJERO_TEMPLATE=🔔 Hey!: %s

# Timezone config (URL to your gist)
GIST_TIMEZONE_URL=https://gist.githubusercontent.com/user/gist_id/raw

# Reminders config
ALERT_LEAD_TIME_MINUTES=0
ALL_DAY_MENSAJERO_TIME=09:00
SUMMARY_TASK_TIME=07:00
HEARTBEAT_TIME=12:00

# Google OAuth Credentials (Single quotes are required to preserve JSON structure)
GOOGLE_CREDENTIALS_JSON='{"installed":{"client_id":"...","project_id":"...","auth_uri":"...","token_uri":"...","client_secret":"...","redirect_uris":["http://localhost"]}}'

# Dashboard Authentication (protects the web UI)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=your_strong_password_here

# Ports for both daemons (Matches docker-compose.yml)
GESTOR_PORT=8080
MENSAJERO_PORT=3000