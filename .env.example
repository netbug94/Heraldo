# ========================================================
# TaskSystem Environment Variables
# Copy this to .env
# ========================================================

# Secure API Key shared between the Relay and Brain
API_KEY=your_secure_shared_api_key_here

# Internal URL for Brain to reach the Relay container
RELAY_URL=http://relay:3000

# This must match the API_KEY above
RELAY_API_KEY=your_secure_shared_api_key_here

# The WhatsApp Phone number to send tasks to (include country code)
RELAY_PHONE=+1234567890

# Message template
RELAY_TEMPLATE=You have a new task: %s

# Timezone config (URL to your gist)
GIST_TIMEZONE_URL=your_gist_url_here

# Reminders config
ALERT_LEAD_TIME_MINUTES=15
ALL_DAY_RELAY_TIME=09:00
