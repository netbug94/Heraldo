# ========================================================
# Heraldo Environment Variables
# Copy this to .env
# ========================================================

# Secure API Key shared between Mensajero and Gestor
API_KEY=your_secure_shared_api_key_here

# Internal URL for Gestor to reach the Mensajero container
MENSAJERO_URL=http://mensajero:3000

# This must match the API_KEY above
MENSAJERO_API_KEY=your_secure_shared_api_key_here

# The WhatsApp Phone number to send tasks to (include country code)
MENSAJERO_PHONE=+1234567890

# Message template
MENSAJERO_TEMPLATE=You have a new task: %s

# Timezone config (URL to your gist)
GIST_TIMEZONE_URL=your_gist_url_here

# Reminders config
ALERT_LEAD_TIME_MINUTES=15
ALL_DAY_MENSAJERO_TIME=09:00
SUMMARY_TASK_TIME=09:00
HEARTBEAT_TIME=08:00

# Dashboard Authentication (protects the web UI from unauthorized access on your LAN)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=your_strong_password_here
